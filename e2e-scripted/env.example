# Copy to .env and fill in the physical iPhone values.
OPENBASE_IOS_UDID=00008110-0000000000000000
OPENBASE_IOS_DEVICE_NAME=Gabe's iPhone
OPENBASE_IOS_PLATFORM_VERSION=18.0
OPENBASE_IOS_BUNDLE_ID=com.openbase.coder.field-test

# Leave empty when the app is already installed. Set to an .app or .ipa path when
# Appium should install a build artifact before testing.
OPENBASE_IOS_APP_PATH=

# Required for WebDriverAgent signing on a physical iPhone.
OPENBASE_IOS_XCODE_ORG_ID=
OPENBASE_IOS_XCODE_SIGNING_ID=iPhone Developer
OPENBASE_IOS_WDA_BUNDLE_ID=com.openbase.coder.WebDriverAgentRunner

# Real signup is allowed only with an exact Resend testing recipient that is
# also present in production FIELD_TEST_ALLOWED_EMAILS. Never use a real inbox.
OPENBASE_E2E_SIGNUP_EMAIL=delivered+openbase-field-<opaque-run-slug>@resend.dev
OPENBASE_E2E_FIELD_TEST_ALLOWED_EMAILS=delivered+openbase-field-<opaque-run-slug>@resend.dev

# Appium server config. The WebDriverIO service starts Appium locally by default.
OPENBASE_E2E_APPIUM_HOST=127.0.0.1
OPENBASE_E2E_APPIUM_PORT=4723
OPENBASE_E2E_APPIUM_LOG_LEVEL=info

# Which local Openbase runtime the live suite is expected to drive:
# any, standalone, electron-bundled, or workspace.
OPENBASE_E2E_EXPECT_RUNTIME=any

# Live no-mock E2E should use production Openbase Cloud unless Gabe explicitly
# asks for another target.
OPENBASE_E2E_EXPECT_WEB_BACKEND=https://app.openbase.cloud
OPENBASE_E2E_EXPECT_CODING_BACKEND=openbase_cloud

# Audio playback is guarded so a manual run cannot unexpectedly speak.
OPENBASE_E2E_ENABLE_AUDIO_STIMULUS=0
OPENBASE_E2E_AUDIO_PHRASE=hello openbase
OPENBASE_E2E_CARTESIA_API_KEY=
OPENBASE_E2E_CARTESIA_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
OPENBASE_E2E_CARTESIA_MODEL_ID=sonic-3.5
OPENBASE_E2E_CARTESIA_VERSION=2026-03-01

# Real Codex is opt-in and may call Gabe's Codex/OpenAI account. The manual
# package script sets these guards automatically.
OPENBASE_E2E_ALLOW_REAL_CODEX=0
OPENBASE_E2E_CONFIRM_REAL_CODEX=0

# Voice assertions default to TTS intent + LiveKit/log evidence. STT is opt-in
# because it may spend money and should mainly be used for pronunciation tests.
OPENBASE_E2E_TTS_COMMAND=
OPENBASE_E2E_LIVEKIT_LOG_PATH=~/.openbase/logs/livekit-agent.log
OPENBASE_E2E_LIVEKIT_LOG_LOOKBACK_MS=120000
OPENBASE_E2E_ENABLE_STT_ASSERTIONS=0
