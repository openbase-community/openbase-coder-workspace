#!/bin/sh
# Workspace pre-push hook, run by every repo in this multi workspace
# (multi.json "hooks"; installed by `multi sync` / `multi hooks install`).
# For each pushed ref, over the commits the remote does not have yet:
#   1. gitleaks over those commits.
#   2. Public repos: refuse commits that add or change .reports/ paths.
# Then the repo's own pre-push (boundary guards), fed the same stdin.
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"

ZERO=0000000000000000000000000000000000000000
input=$(cat)
status=0

scan=1
if skip_secret_scan push; then
  scan=0
else
  GITLEAKS=$(find_gitleaks pre-push) || exit 1
fi
public=1
repo_is_private && public=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue # branch deletion
  if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$remote_sha..$local_sha"
  else
    # New branch, or the remote tip is unknown locally: everything not
    # already on a remote-tracking ref.
    range="$local_sha --not --remotes"
  fi

  if [ $scan = 1 ]; then
    run_gitleaks pre-push --log-opts="$range" || status=1
  fi

  if [ $public = 1 ]; then
    # shellcheck disable=SC2086 # range and REPORTS_PATHSPEC are word lists
    hits=$(git log --format= --name-only --diff-filter=d $range -- $REPORTS_PATHSPEC | sort -u)
    if [ -n "$hits" ]; then
      hook_err "pre-push: BLOCKED - commits add or change private .reports/ paths in this public repo:"
      printf '%s\n' "$hits" | sed 's/^/  /' >&2
      hook_err "  Remove them from those commits (rebase/amend) before pushing."
      status=1
    fi
  fi
done <<INPUT
$input
INPUT

if chained=$(repo_local_hook pre-push); then
  printf '%s\n' "$input" | "$chained" "$@" || status=1
fi

exit $status
