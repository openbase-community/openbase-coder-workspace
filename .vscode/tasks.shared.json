{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Openbase: Start Launchctl Services",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/openbase-coder",
            "args": [
                "services",
                "start"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            }
        },
        {
            "label": "Openbase: Stop Launchctl Services",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/openbase-coder",
            "args": [
                "services",
                "stop"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            }
        },
        {
            "label": "Openbase Desktop: Dev Dashboard (Electron)",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/dev-launch",
            "args": ["--electron"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Openbase Network: Dev Menu Bar (Swift)",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/dev-launch",
            "args": ["--menu-bar"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
