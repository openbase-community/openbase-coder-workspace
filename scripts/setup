#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
ROOT_DIR="$( cd "$SCRIPT_DIR/.." && pwd )"
INSTALLATION_PATH="${HOME}/.openbase/installation.json"
STANDALONE_CLI_PATH="${HOME}/.openbase/packages/standalone/current/bin/openbase-coder"
UNINSTALL_URL="https://docs.openbase.cloud/uninstall/"

real_path() {
  local target="$1"
  if [ -d "$target" ]; then
    (cd "$target" && pwd -P)
  else
    local parent
    parent="$(dirname "$target")"
    local name
    name="$(basename "$target")"
    (cd "$parent" 2>/dev/null && printf "%s/%s\n" "$(pwd -P)" "$name")
  fi
}

existing_install_message() {
  cat <<EOF
Existing Openbase Coder installation found.

This development setup script is for a clean source-workspace install. To switch
from an existing standalone or different workspace install, uninstall Openbase
Coder first:

  ${UNINSTALL_URL}

After uninstalling, rerun ./scripts/setup from this workspace.
EOF
}

check_existing_installation() {
  local root_real
  root_real="$(real_path "$ROOT_DIR")"

  if [ -f "$INSTALLATION_PATH" ]; then
    local standalone
    standalone="$(sed -nE 's/.*"standalone"[[:space:]]*:[[:space:]]*(true|false).*/\1/p' "$INSTALLATION_PATH" | tail -n 1)"
    local workspace_path
    workspace_path="$(sed -nE 's/.*"workspace_path"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' "$INSTALLATION_PATH" | tail -n 1)"

    if [ "$standalone" = "true" ]; then
      existing_install_message
      exit 1
    fi

    if [ -n "$workspace_path" ] && [ -d "$workspace_path" ]; then
      local workspace_real
      workspace_real="$(real_path "$workspace_path")"
      if [ "$workspace_real" = "$root_real" ]; then
        echo "Existing development installation already points at this workspace; continuing."
        return
      fi
    fi

    existing_install_message
    exit 1
  fi

  if [ -e "$STANDALONE_CLI_PATH" ]; then
    existing_install_message
    exit 1
  fi
}

check_existing_installation

# Fail fast on missing prerequisites instead of dying mid-setup on a raw
# "command not found".
MISSING_PREREQ=false

# `uv tool install` (multi) and the standalone uv installer (uv itself) put
# their executables in uv's tool bin dir, which a fresh macOS shell does not
# have on PATH. Reporting those as "not installed" sends the user into a loop
# (reinstalling says it is already installed), so use the tool from there for
# this run and print the PATH fix instead.
UV_TOOL_BIN="${UV_TOOL_BIN_DIR:-${XDG_BIN_HOME:-${HOME}/.local/bin}}"
OFF_PATH_TOOLS=""

require_command() {
  local cmd="$1"
  local fix="$2"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    if [ -x "$UV_TOOL_BIN/$cmd" ]; then
      OFF_PATH_TOOLS="${OFF_PATH_TOOLS:+$OFF_PATH_TOOLS, }$cmd"
      return
    fi
    echo "Error: '$cmd' is required but was not found on PATH. Install it with:" >&2
    echo "  $fix" >&2
    MISSING_PREREQ=true
  fi
}

require_command uv "curl -LsSf https://astral.sh/uv/install.sh | sh"
require_command multi "uv tool install multi-workspace"
# Developer installs build the embedded Openbase Direct transport from the
# checked-out Go source. Check this up front with the other workspace tools so
# choosing Direct cannot fail after the console and Python environment build.
require_command go "brew install go   # or download the current toolchain from https://go.dev/dl/"
# Internal checkouts build the Swift menu-bar UI from netmesh-macos when setup
# launches the developer app; check its tools now rather than at the end.
if [ "$(uname -s)" = "Darwin" ] && [ -d "$ROOT_DIR/netmesh-macos" ]; then
  require_command xcodegen "brew install xcodegen"
  require_command xcodebuild "Install Xcode from the App Store, then run: sudo xcode-select -s /Applications/Xcode.app"
fi

if [ -n "$OFF_PATH_TOOLS" ]; then
  export PATH="$UV_TOOL_BIN:$PATH"
  echo "Note: found ${OFF_PATH_TOOLS} in ${UV_TOOL_BIN}, which is not on your PATH." >&2
  echo "Setup uses ${OFF_PATH_TOOLS} from there for this run. To fix PATH for new terminals, run:" >&2
  echo "  uv tool update-shell   # then open a new terminal" >&2
  echo "or add this line to your shell profile:" >&2
  echo "  export PATH=\"${UV_TOOL_BIN}:\$PATH\"" >&2
fi

# The dev-workspace console build hard-requires pnpm (pnpm workspace with
# workspace:* deps — npm is not a fallback). Check the same locations the CLI
# checks (PATH plus known pnpm homes) so setup fails here, not mid-install.
require_pnpm() {
  if command -v pnpm >/dev/null 2>&1; then
    return
  fi
  local candidate
  for candidate in \
    "${PNPM_HOME:-}/pnpm" \
    "${HOME}/Library/pnpm/pnpm" \
    "${HOME}/.local/share/pnpm/pnpm"; do
    if [ -x "$candidate" ]; then
      return
    fi
  done
  echo "Error: 'pnpm' is required but was not found on PATH. Install it with:" >&2
  echo "  curl -fsSL https://get.pnpm.io/install.sh | sh -" >&2
  MISSING_PREREQ=true
}

require_pnpm

# The console build (Vite) and workspace tooling need a modern Node. CI
# builds on Node 22; 20 is the supported floor.
MIN_NODE_MAJOR=20
require_node() {
  if ! command -v node >/dev/null 2>&1; then
    echo "Error: 'node' (>= ${MIN_NODE_MAJOR}) is required but was not found on PATH. Install it with:" >&2
    echo "  brew install node   # or: pnpm env use --global 22" >&2
    MISSING_PREREQ=true
    return
  fi
  local node_version node_major
  node_version="$(node --version 2>/dev/null)"
  node_major="$(printf '%s' "$node_version" | sed -nE 's/^v([0-9]+)\..*/\1/p')"
  if [ -z "$node_major" ] || [ "$node_major" -lt "$MIN_NODE_MAJOR" ]; then
    echo "Error: Node >= ${MIN_NODE_MAJOR} is required (found ${node_version:-unknown}). Upgrade with:" >&2
    echo "  brew upgrade node   # or: pnpm env use --global 22" >&2
    MISSING_PREREQ=true
  fi
}

require_node

if [ "$MISSING_PREREQ" = true ]; then
  echo "Install the missing prerequisites above, then re-run ./scripts/setup." >&2
  exit 1
fi

# With no flags on a terminal, setup runs interactively: after the repo sync
# it prompts with pickers for the coding backend and the voice audio
# provider. Any flag means non-interactive — no prompts, safe for scripts
# and AI agents (a fresh install then requires --backend).
USER_ARG_COUNT=$#
if [ "$USER_ARG_COUNT" -eq 0 ] && [ -t 0 ]; then
  echo "No flags passed — setup will prompt you to pick a coding backend and voice audio provider."
fi

# Preserve the workspace's current Multi shape. A contributor checkout with a
# dev-only repo must stay on the dev install set; syncing it as default rewrites
# managed ignores and makes the remaining dev repos appear untracked. A fresh
# public checkout still uses default and does not require private repo access.
INSTALL_SET="$(node "$SCRIPT_DIR/detect-install-set.mjs" "$ROOT_DIR")"
if [ -z "$INSTALL_SET" ]; then
  echo "Error: could not detect the Multi install set for $ROOT_DIR." >&2
  exit 1
fi
echo "Syncing the Multi '${INSTALL_SET}' install set."
pushd "$ROOT_DIR"
multi sync --install-set "$INSTALL_SET"
# Multi clones missing unlocked repos on the workspace branch, but intentionally
# leaves existing repo checkouts alone. Refuse a mixed source tree instead of
# silently installing (for example) root develop with an existing cli on main.
# Check only the selected install set: a public/default checkout intentionally
# omits internal-only repositories.
if ! node "$SCRIPT_DIR/check-workspace-branches.mjs" "$ROOT_DIR" "$INSTALL_SET"; then
  echo "Error: workspace repositories are not on their expected branches." >&2
  echo "Run 'multi set-branch $(git branch --show-current)' after making every repo clean, then rerun setup." >&2
  exit 1
fi
popd

# Run the full local Openbase setup against this checkout, wherever it lives.
SETUP_ARGS=("$@")
SETUP_ARGS_COUNT=$#
HAS_WORKSPACE_DIR=false

prepend_setup_args() {
  if [ "$SETUP_ARGS_COUNT" -eq 0 ]; then
    SETUP_ARGS=("$@")
  else
    SETUP_ARGS=("$@" "${SETUP_ARGS[@]}")
  fi
  SETUP_ARGS_COUNT=${#SETUP_ARGS[@]}
}

for arg in "$@"; do
  case "$arg" in
    --workspace-dir|--workspace-dir=*)
      HAS_WORKSPACE_DIR=true
      ;;
  esac
done

if [ "$HAS_WORKSPACE_DIR" = false ]; then
  prepend_setup_args --workspace-dir "$ROOT_DIR"
fi

# The injected --workspace-dir would otherwise flip the CLI to
# non-interactive; keep the flagless-terminal run interactive explicitly.
if [ "$USER_ARG_COUNT" -eq 0 ] && [ -t 0 ]; then
  prepend_setup_args --interactive
fi

# The ℹ️ setup summaries and then the phone-app QR code are the last things
# setup prints, after the developer app is built and launched, so the CLI step
# leaves them to this script.
SETUP_NOTES_FILE="$(mktemp "${TMPDIR:-/tmp}/openbase-setup-notes.XXXXXX")"
trap 'rm -f "$SETUP_NOTES_FILE"' EXIT
prepend_setup_args --defer-app-qr --deferred-notes-file "$SETUP_NOTES_FILE"

pushd "${ROOT_DIR}"/cli
uv run openbase-coder setup "${SETUP_ARGS[@]}"
popd

# Launch GUI apps only in a logged-in macOS desktop session (not over SSH or
# from a background job). OPENBASE_SETUP_NO_LAUNCH=1 opts out.
has_gui_session() {
  [ "$(uname -s)" = "Darwin" ] || return 1
  [ "${OPENBASE_SETUP_NO_LAUNCH:-0}" != "1" ] || return 1
  [ "$(launchctl managername 2>/dev/null)" = "Aqua" ]
}

# The Electron developer app is a required part of a source install, not an
# optional extra: verify/repair its runtime (any platform) and, on macOS, build
# the renderer, publish the /Applications launcher and launch it together with
# the Swift menu-bar UI. Each step fails setup loudly; "Setup complete" is only
# printed once the app is built.
if [ -f "$ROOT_DIR/desktop/package.json" ]; then
  node "$SCRIPT_DIR/ensure-electron-runtime.mjs" "$ROOT_DIR"
  if [ "$(uname -s)" = "Darwin" ]; then
    APP_PATH="/Applications/Openbase.app"
    # dev-launch runs Electron in the foreground when a packaged app occupies
    # /Applications, which would hold setup open; only launch the launcher.
    if [ -e "$APP_PATH" ] && [ ! -f "$APP_PATH/Contents/Resources/.openbase-dev-launcher" ] && [ "${OPENBASE_DEV_DASHBOARD_REPLACE_APP:-0}" != "1" ]; then
      PACKAGED_APP_PRESENT=true
    else
      PACKAGED_APP_PRESENT=false
    fi
    if has_gui_session && [ "$PACKAGED_APP_PRESENT" = false ]; then
      # Electron never owns setup in a source-workspace install: dev-launch
      # forces dashboard-only mode; this script stays the setup authority.
      "$ROOT_DIR/scripts/dev-launch" --all
    else
      "$ROOT_DIR/scripts/dev-launch" --build-only
      echo "Launch the developer app and the Swift menu-bar UI with:"
      echo "  ./scripts/dev-launch --all"
    fi
  fi
fi

echo "Setup complete. The Openbase services, browser dashboard and developer app are ready."
cat "$SETUP_NOTES_FILE"
echo

pushd "${ROOT_DIR}"/cli >/dev/null
uv run openbase-coder app-download-qr
popd >/dev/null
echo "Last step: install the Openbase iOS or Android app from the link above and sign in."
