#!/usr/bin/env bash

# MANUAL FALLBACK ONLY: build + publish the Openbase Coder Android APK from
# this checkout, then bump the marketing downloads-card version label.
#
# The normal release path does not use this script. The android repo's own CI
# (.github/workflows/android-release.yml) rebuilds the netmesh VPN AAR from
# netmesh-go main and publishes the APK on every push to main/staging;
# scripts/promote waits for that run and only bumps the marketing label
# (scripts/bump-android-downloads-card). Use this script only when that CI is
# broken and an APK must be published by hand, and understand that it
# publishes whatever this checkout builds.
#
# Steps:
#   1. Guards (below).
#   2. Detect JAVA_HOME (honor $JAVA_HOME if it has javac, else prefer
#      Homebrew openjdk@17, else /usr/libexec/java_home).
#   3. Run android/scripts/build-and-upload-apk.sh — builds the debug APK and
#      uploads versioned + latest keys to S3 (that script owns aws/metadata).
#   4. Bump the "Direct APK · vX.Y.Z" marketing card via
#      scripts/bump-android-downloads-card (reads versionName from
#      android/app/build.gradle.kts).
#
# Guards (each is a hard failure):
#   - Never builds in a trunk checkout: this workspace must live under a
#     *-worktrees/ folder (an MWW or a throwaway worktree). Builds in the
#     shared main checkout collide with every other agent and service.
#   - Refuses a stale VPN engine: android/app/libs/netmeshgo.aar is untracked
#     and vendored by android/scripts/build-netmeshgo-aar.sh, which records
#     the netmesh-go commit it was built from in
#     android/app/libs/netmeshgo.aar.netmesh-sha. That recorded commit must
#     equal netmesh-go's current origin/main (what CI builds against); a
#     missing or older sidecar means an APK that lacks engine fixes users
#     already have on other platforms (2026-10-14: an Oct 2 AAR shipped as
#     "latest" for 15 minutes). Rebuild the AAR, then re-run.
#   Other hard failures: missing JDK, build/upload failure, unreadable
#   version, marketing label not matching, git commit/push failure.
#   Soft skips (marketing checkout missing, install.html locally modified)
#   come from bump-android-downloads-card and exit 0 with a WARNING.
#
# Options:
#   --dry-run   Run the guards, then print exactly what would happen (JDK,
#               version, the label before/after, the commit/push) without
#               building, uploading, writing, committing, or pushing.
#
# Environment:
#   NETMESH_GO_DIR   netmesh-go checkout whose `origin` is asked for main
#                    (default: <workspace>/netmesh-go; same variable the AAR
#                    build script uses). Without a checkout, `gh api` on
#                    openbase-community/netmesh-go is used instead.
#   MARKETING_REPO   passed through to bump-android-downloads-card.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

ANDROID_DIR="${ROOT_DIR}/android"
APP_GRADLE="${ANDROID_DIR}/app/build.gradle.kts"
BUILD_SCRIPT="${ANDROID_DIR}/scripts/build-and-upload-apk.sh"
AAR="${ANDROID_DIR}/app/libs/netmeshgo.aar"
AAR_SHA_FILE="${AAR}.netmesh-sha"
NETMESH_GO_DIR="${NETMESH_GO_DIR:-${ROOT_DIR}/netmesh-go}"
NETMESH_GO_SLUG="openbase-community/netmesh-go"

DRY_RUN=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1 ;;
        -h|--help)
            sed -n '3,52p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *) echo "Unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

die() { echo "ERROR: $*" >&2; exit 1; }

# --- guard: never in a trunk checkout ------------------------------------
case "$ROOT_DIR" in
    *-worktrees/*) ;;
    *)
        echo "ERROR: refusing to build in the trunk checkout ${ROOT_DIR}." >&2
        echo "  Run it from an MWW (multi worktree add <name>) or a throwaway worktree under a *-worktrees/ folder." >&2
        echo "  The normal release path is the android repo's CI (android-release.yml), driven by scripts/promote." >&2
        exit 2
        ;;
esac

# --- guard: the vendored VPN engine must match netmesh-go main -----------
netmesh_main_sha() {
    local sha=""
    if [[ -d "${NETMESH_GO_DIR}/.git" ]]; then
        sha="$(git -C "$NETMESH_GO_DIR" ls-remote --exit-code origin refs/heads/main 2>/dev/null | awk '{print $1}' || true)"
    fi
    if [[ -z "$sha" ]] && command -v gh >/dev/null 2>&1; then
        sha="$(gh api "repos/${NETMESH_GO_SLUG}/commits/main" --jq .sha 2>/dev/null || true)"
    fi
    [[ -n "$sha" ]] || return 1
    echo "$sha"
}

[[ -f "$AAR" ]] || die "No VPN engine at ${AAR}. Build it with android/scripts/build-netmeshgo-aar.sh (a stub build cannot reach the backend and must never be published)."
[[ -f "$AAR_SHA_FILE" ]] || die "${AAR_SHA_FILE} is missing, so the netmesh-go commit this AAR was built from is unknown. Rebuild it with android/scripts/build-netmeshgo-aar.sh (which records the commit), then re-run."
recorded_sha="$(tr -d '[:space:]' < "$AAR_SHA_FILE")"
[[ "$recorded_sha" =~ ^[0-9a-f]{40}$ ]] || die "${AAR_SHA_FILE} does not contain a full commit SHA ('${recorded_sha}'). Rebuild the AAR with android/scripts/build-netmeshgo-aar.sh."
main_sha="$(netmesh_main_sha)" || die "Could not resolve netmesh-go origin/main (checked ${NETMESH_GO_DIR} and gh api ${NETMESH_GO_SLUG}). Set NETMESH_GO_DIR to a netmesh-go checkout with an origin remote, or sign in with gh."
if [[ "$recorded_sha" != "$main_sha" ]]; then
    echo "ERROR: stale VPN engine: ${AAR} was built from netmesh-go ${recorded_sha:0:12}," >&2
    echo "  but netmesh-go main is ${main_sha:0:12} (what android-release.yml publishes)." >&2
    echo "  Pull netmesh-go main, rebuild with android/scripts/build-netmeshgo-aar.sh, then re-run." >&2
    exit 1
fi
echo "VPN engine OK: netmeshgo.aar built from netmesh-go main ${main_sha:0:12}."

# --- JAVA_HOME detection --------------------------------------------------
detect_java_home() {
    local jh
    if [[ -n "${JAVA_HOME:-}" && -x "${JAVA_HOME}/bin/javac" ]]; then
        echo "$JAVA_HOME"
        return 0
    fi
    if [[ -x /opt/homebrew/opt/openjdk@17/bin/javac ]]; then
        echo /opt/homebrew/opt/openjdk@17
        return 0
    fi
    if [[ -x /usr/libexec/java_home ]]; then
        if jh="$(/usr/libexec/java_home -v 17 2>/dev/null)" && [[ -n "$jh" ]]; then
            echo "$jh"; return 0
        fi
        if jh="$(/usr/libexec/java_home 2>/dev/null)" && [[ -n "$jh" ]]; then
            echo "$jh"; return 0
        fi
    fi
    return 1
}

if ! JAVA_HOME_DETECTED="$(detect_java_home)"; then
    die "No JDK found (checked \$JAVA_HOME, /opt/homebrew/opt/openjdk@17 and /usr/libexec/java_home). Install openjdk@17."
fi

# --- versionName ----------------------------------------------------------
[[ -f "$APP_GRADLE" ]] || die "app/build.gradle.kts not found at $APP_GRADLE"
version_name="$(sed -n 's/.*versionName = "\([^"]*\)".*/\1/p' "$APP_GRADLE" | head -n 1)"
[[ -n "$version_name" ]] || die "Could not read versionName from $APP_GRADLE"

echo "Android APK publish (manual fallback)"
echo "  JAVA_HOME:   $JAVA_HOME_DETECTED"
echo "  versionName: $version_name"
echo "  build:       $BUILD_SCRIPT"
echo

# --- 1. build + upload APK ------------------------------------------------
[[ -x "$BUILD_SCRIPT" ]] || die "Build script not found or not executable: $BUILD_SCRIPT"

if [[ "$DRY_RUN" == "1" ]]; then
    echo "[dry-run] would run: JAVA_HOME=$JAVA_HOME_DETECTED $BUILD_SCRIPT"
else
    echo "Building and uploading APK ..."
    JAVA_HOME="$JAVA_HOME_DETECTED" "$BUILD_SCRIPT"
fi
echo

# --- 2. marketing downloads-card label bump -------------------------------
bump_args=("$version_name")
[[ "$DRY_RUN" == "1" ]] && bump_args+=(--dry-run)
exec "${SCRIPT_DIR}/bump-android-downloads-card" "${bump_args[@]}"
