#!/usr/bin/env bash

# Promote branches across the workspace repos, in dependency order, as a
# fast-forward-only burst.
#
# Providers are pushed before consumers so anything that rebuilds on a branch
# push always sees its dependencies already advanced, and pushes land close
# together. Repos whose branches are already even are skipped entirely so
# they trigger no rebuild/release.
#
# Order rationale: super-agents is the Python lib cli builds against;
# coder-react is the JS lib console/desktop consume; the cli
# standalone release embeds console/coder-react/skills/super-agents at build
# time, so all of those land before cli. Pushing main auto-cuts the cli
# standalone release (auto-release.yml), the desktop AppImage to S3
# (electron-rebuild.yml), and the ios App Store upload. A cli push whose
# head commit says [skip release] cuts no release and never cancels an
# in-flight release build (conditional cancel-in-progress; dev-docs/AUTO_UPDATE.md).
# multi-react and boilersync-react are external symlinks — promote them in
# their own workspaces (~/Projects/multi, ~/Projects/boilersync) first if
# they changed.
#
# When a promotion into main/master actually moves the android repo, this
# script runs scripts/publish-android-apk as its final step (build + upload
# the APK to S3, bump the marketing downloads-card label). That runs after
# every push, so a failure there never unwinds the promotions — it just prints
# a loud error summary and exits non-zero at the end.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

# Dependency order: providers before consumers; workspace root last.
REPOS=(super-agents skills coder-react console cli desktop allauth-client-swift openbase-agent-ui-swift ios allauth-client-kotlin openbase-agent-ui-kotlin android .)

# --- multi.json coverage gate + pinned-repo verification --------------------
# Everything in multi.json is part of a deploy even when it never receives a
# FROM->TO push. Unpinned repos must appear in REPOS (ordering is curated, so
# a new repo forces a deliberate placement here), and fixedBranch repos are
# verified below so unpushed trunk work cannot silently miss a release bake.
MULTI_UNPINNED=()
MULTI_PINNED=()
while IFS=: read -r mj_name mj_branch; do
    if [[ -z "$mj_branch" ]]; then
        MULTI_UNPINNED+=("$mj_name")
    else
        MULTI_PINNED+=("${mj_name}:${mj_branch}")
    fi
done < <(python3 -c '
import json, sys
for repo in json.load(open(sys.argv[1]))["repos"]:
    print(f"{repo["name"]}:{repo.get("fixedBranch", "")}")
' "${ROOT_DIR}/multi.json")

for mj_name in ${MULTI_UNPINNED[@]+"${MULTI_UNPINNED[@]}"}; do
    mj_found=0
    for repo in "${REPOS[@]}"; do
        [[ "$repo" == "$mj_name" ]] && mj_found=1 && break
    done
    if [[ "$mj_found" == 0 ]]; then
        echo "multi.json repo '${mj_name}' is not covered by this script's REPOS list." >&2
        echo "Add it at a deliberate position in $(basename "$0") — push order matters." >&2
        exit 1
    fi
done

EXTERNAL_NOTE=""
if [[ ${#MULTI_PINNED[@]} -gt 0 ]]; then
    EXTERNAL_NOTE="pinned to their multi.json fixedBranch (verified below, never pushed by promote):"
    for mj_entry in "${MULTI_PINNED[@]}"; do
        EXTERNAL_NOTE+=" ${mj_entry%%:*}@${mj_entry##*:}"
    done
fi

plan_pinned_repos() {
    local entry name branch label dir local_sha origin_sha dirty detail
    for entry in ${MULTI_PINNED[@]+"${MULTI_PINNED[@]}"}; do
        name="${entry%%:*}"; branch="${entry##*:}"
        label="${name}"
        dir="${ROOT_DIR}/${name}"
        if [[ ! -e "${dir}/.git" ]]; then
            PLAN_REPO+=("$label"); PLAN_ACTION+=(skip)
            PLAN_DETAIL+=("pinned @${branch}; not checked out here — origin/${branch} ships")
            continue
        fi
        git -C "$dir" fetch origin --quiet "$branch" || true
        local_sha="$(git -C "$dir" rev-parse --verify --quiet "refs/heads/${branch}" || true)"
        origin_sha="$(git -C "$dir" rev-parse --verify --quiet "origin/${branch}" || true)"
        dirty="$(git -C "$dir" status --porcelain 2>/dev/null | grep -cv 'sync-conflict' || true)"
        if [[ -n "$local_sha" && -n "$origin_sha" ]]             && ! git -C "$dir" merge-base --is-ancestor "$local_sha" "$origin_sha"; then
            PLAN_REPO+=("$label"); PLAN_ACTION+=(FAIL)
            PLAN_DETAIL+=("pinned @${branch} has unpushed local commits — the release bakes origin/${branch}; push or drop them")
            FAILED=1
            continue
        fi
        detail="pinned @${branch}; origin $(git -C "$dir" rev-parse --short "origin/${branch}" 2>/dev/null || echo '?') ships"
        if [[ "$dirty" != "0" ]]; then
            detail+=" (local tree dirty — not shipped)"
        fi
        PLAN_REPO+=("$label"); PLAN_ACTION+=(skip); PLAN_DETAIL+=("$detail")
    done
}


# These are the authoritative pre-release gates for production promotions
# (TO is main/master), unless --skip-checks. Format:
# "label|repo dir|command|severity" where
# severity is `fatal` (failure aborts the whole promotion) or `warn` (failure
# only prints a warning). Edit this list to change what a production promotion
# gates on.
# Context column: `committed` checks run in a temporary assembly built from
# the origin/FROM refs, so another agent's dirty/untracked working-tree files
# can never fail (or pass) a promotion gate — tsc compiles everything under
# src/, including foreign scratch files, which is exactly how two promotions
# were force-skipped in Aug 2026. `local` checks stay in the real checkout:
# the cli suite needs its established venv, and the mac preflight inspects
# machine-local signing credentials by design.
PRECHECKS=(
    "cli test suite|cli|uv run pytest -q|fatal|local"
    "console typecheck|console|pnpm exec tsc --noEmit -p tsconfig.app.json|fatal|committed"
    "desktop typecheck|desktop|pnpm exec tsc --noEmit -p tsconfig.app.json|fatal|committed"
    "desktop mac-release prereqs|desktop|pnpm run release:preflight:mac|warn|local"
)

usage() {
    cat <<EOF
Usage: $(basename "$0") FROM TO [options]

Fast-forward FROM into TO across every workspace repo, provider-first
(${REPOS[*]}). FROM and TO are any branch names — feature branches work too;
repos that do not have FROM are skipped, as are repos already even (no
rebuild/release triggered). Aborts before pushing anything if any repo cannot
fast-forward, or if promoted content pins a sibling repo to a less-stable
branch ref (e.g. git+...@staging landing on main — main must point to main).

Examples:
  $(basename "$0") staging main
  $(basename "$0") develop staging
  $(basename "$0") feature/my-feature staging

Before promoting into main/master, pre-release checks run automatically (cli
test suite, console/desktop typecheck; desktop mac-release
prereqs as a non-blocking warning). A failing fatal check aborts before any
push. Other targets skip the checks.

Options:
  --dry-run          Show the plan and exit without pushing (no checks run).
  --skip-checks      Skip the pre-release checks (still gated on fast-forward).
  --exclude REPO     Hold REPO back (repeatable; comma-separated allowed).
                     Use for consumers that must wait on an earlier repo's
                     release, e.g. --exclude desktop while the cli release
                     publishes, then re-run to promote desktop alone.
  -y, --yes          Push without the confirmation prompt.
  --no-wait-ci       Do not sequence desktop behind the cli auto-release and
                     do not watch the desktop rebuild (fire-and-forget).
  -h, --help         Show this help text.
EOF
}

DRY_RUN=0
ASSUME_YES=0
WAIT_CI=1
SKIP_CHECKS=0
declare -a EXCLUDE=()
FROM=""
TO=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1 ;;
        --skip-checks) SKIP_CHECKS=1 ;;
        --exclude)
            shift
            [[ $# -gt 0 ]] || { echo "--exclude needs a repo name" >&2; usage >&2; exit 2; }
            IFS=',' read -ra _ex <<<"$1"
            EXCLUDE+=("${_ex[@]}")
            ;;
        -y|--yes) ASSUME_YES=1 ;;
        --no-wait-ci) WAIT_CI=0 ;;
        -h|--help) usage; exit 0 ;;
        -*) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
        *)
            if [[ -z "$FROM" ]]; then FROM="$1"
            elif [[ -z "$TO" ]]; then TO="$1"
            else echo "Unexpected argument: $1" >&2; usage >&2; exit 2
            fi
            ;;
    esac
    shift
done

if [[ -z "$FROM" || -z "$TO" ]]; then
    usage >&2
    exit 2
fi
if [[ "$FROM" == "$TO" ]]; then
    echo "FROM and TO must differ." >&2
    exit 2
fi

repo_label() {
    if [[ "$1" == "." ]]; then echo "workspace-root"; else echo "$1"; fi
}

is_excluded() {
    local r="$1" e
    ((${#EXCLUDE[@]})) || return 1
    for e in "${EXCLUDE[@]}"; do
        [[ "$e" == "$r" ]] && return 0
    done
    return 1
}

# "Main points to main": content promoted into a stabler branch must not pin
# sibling repos to a less-stable branch ref. Branch-agnostic dep forms
# (file:../, workspace:*, PyPI pins) pass by construction; only branch-pinned
# git URLs are flagged. Prints offending lines; returns 0 when clean.
check_branch_refs() {
    local dir="$1" rev="$2" guarded=""
    case "$TO" in
        main|master) guarded='staging|develop' ;;
        staging) guarded='develop' ;;
        *) return 0 ;;
    esac
    local pattern="(git\\+http|github:|git@github)[^\"'[:space:]]*[@#](${guarded})([^A-Za-z0-9_-]|\$)"
    ! git -C "$dir" grep -nIE "$pattern" "$rev" -- 2>/dev/null
}

# Assembly of the committed origin/FROM refs for `committed`-context checks.
# Shape mirrors the real pnpm workspace: the workspace-root repo as the base
# worktree (manifests, lockfile, e2e), sibling JS repos as worktrees, and the
# externally-symlinked multi-react/boilersync-react as real copies (pnpm
# drops their importers otherwise). Built lazily, removed on exit.
PRECHECK_ASSEMBLY=""
PRECHECK_ASSEMBLY_WORKTREES=()

cleanup_precheck_assembly() {
    local wt repo_dir wt_dir
    for wt in ${PRECHECK_ASSEMBLY_WORKTREES[@]+"${PRECHECK_ASSEMBLY_WORKTREES[@]}"}; do
        IFS='#' read -r repo_dir wt_dir <<<"$wt"
        git -C "$repo_dir" worktree remove --force "$wt_dir" >/dev/null 2>&1 || true
    done
    if [[ -n "$PRECHECK_ASSEMBLY" ]]; then
        rm -rf "$PRECHECK_ASSEMBLY"
    fi
    return 0
}
trap cleanup_precheck_assembly EXIT

build_precheck_assembly() {
    [[ -n "$PRECHECK_ASSEMBLY" ]] && return 0
    PRECHECK_ASSEMBLY="$(mktemp -d "${TMPDIR:-/tmp}/promote-prechecks.XXXXXX")"
    local ws="${PRECHECK_ASSEMBLY}/ws" r
    git -C "$ROOT_DIR" worktree add --detach --quiet "$ws" "origin/${FROM}" || return 1
    PRECHECK_ASSEMBLY_WORKTREES+=("${ROOT_DIR}#${ws}")
    for r in console desktop coder-react; do
        git -C "${ROOT_DIR}/${r}" worktree add --detach --quiet "${ws}/${r}" "origin/${FROM}" || return 1
        PRECHECK_ASSEMBLY_WORKTREES+=("${ROOT_DIR}/${r}#${ws}/${r}")
    done
    for r in multi-react boilersync-react; do
        rsync -aL --exclude node_modules --exclude .git --exclude dist \
            "${ROOT_DIR}/${r}/" "${ws}/${r}/" || return 1
    done
    ( cd "$ws" && pnpm install --prefer-offline --ignore-scripts ) \
        >"${PRECHECK_ASSEMBLY}/pnpm-install.log" 2>&1 || {
        echo "      pnpm install in the precheck assembly failed:"
        sed 's/^/      /' "${PRECHECK_ASSEMBLY}/pnpm-install.log" | tail -n 12
        return 1
    }
}

# Run the pre-release checks before a production promotion. Only gates when
# promoting into main/master; other targets (develop->staging,
# feature->staging) skip the heavy suite. --skip-checks bypasses entirely. A
# fatal check that fails aborts before anything is pushed.
run_prechecks() {
    case "$TO" in
        main|master) : ;;
        *) return 0 ;;
    esac
    if [[ "$SKIP_CHECKS" == "1" ]]; then
        echo "Skipping pre-release checks (--skip-checks)."
        return 0
    fi
    echo "Running pre-release checks before promoting to ${TO} ..."
    echo "(typechecks run against the committed origin/${FROM} refs, not working trees)"
    local failed=0 entry label reldir cmd sev ctx dir out
    for entry in "${PRECHECKS[@]}"; do
        IFS='|' read -r label reldir cmd sev ctx <<<"$entry"
        if [[ "$ctx" == "committed" ]]; then
            if ! build_precheck_assembly; then
                printf '  %-30s FAIL (could not build committed-refs assembly)\n' "$label"
                failed=1
                continue
            fi
            dir="${PRECHECK_ASSEMBLY}/ws/${reldir}"
        else
            dir="${ROOT_DIR}/${reldir}"
            if [[ "$cmd" == *tsc* && ! -d "$dir/node_modules" ]]; then
                printf '  %-30s SKIP (node_modules not installed)\n' "$label"
                continue
            fi
        fi
        if [[ ! -d "$dir" ]]; then
            printf '  %-30s SKIP (no %s)\n' "$label" "$reldir"
            continue
        fi
        printf '  %-30s ... ' "$label"
        out="$(mktemp)"
        if ( cd "$dir" && eval "$cmd" ) >"$out" 2>&1; then
            echo "ok"
        elif [[ "$sev" == "warn" ]]; then
            echo "WARN (non-blocking)"
            sed 's/^/      /' "$out" | tail -n 12
        else
            echo "FAIL"
            sed 's/^/      /' "$out" | tail -n 30
            failed=1
        fi
        rm -f "$out"
    done
    if [[ "$failed" == "1" ]]; then
        echo "Aborting: pre-release checks failed. Fix them, or re-run with --skip-checks to override." >&2
        exit 1
    fi
}

declare -a PLAN_REPO PLAN_ACTION PLAN_DETAIL
FAILED=0
ANDROID_PROMOTED=0

echo "Planning promotion ${FROM} -> ${TO} ..."
if [[ -n "${EXTERNAL_NOTE:-}" ]]; then
    echo "note: ${EXTERNAL_NOTE}"
fi
for repo in "${REPOS[@]}"; do
    dir="${ROOT_DIR}/${repo}"
    label="$(repo_label "$repo")"
    if is_excluded "$repo"; then
        PLAN_REPO+=("$label"); PLAN_ACTION+=(skip); PLAN_DETAIL+=("excluded (--exclude)")
        continue
    fi
    git -C "$dir" fetch origin --quiet
    if ! from_sha="$(git -C "$dir" rev-parse --verify --quiet "origin/${FROM}")"; then
        PLAN_REPO+=("$label"); PLAN_ACTION+=(skip); PLAN_DETAIL+=("no origin/${FROM} branch")
        continue
    fi
    if ! to_sha="$(git -C "$dir" rev-parse --verify --quiet "origin/${TO}")"; then
        PLAN_REPO+=("$label"); PLAN_ACTION+=(FAIL); PLAN_DETAIL+=("no origin/${TO} branch (refusing to create it)")
        FAILED=1
        continue
    fi
    if [[ "$from_sha" == "$to_sha" ]]; then
        PLAN_REPO+=("$label"); PLAN_ACTION+=(skip); PLAN_DETAIL+=("even — no rebuild")
        continue
    fi
    if git -C "$dir" merge-base --is-ancestor "$from_sha" "$to_sha"; then
        PLAN_REPO+=("$label"); PLAN_ACTION+=(skip); PLAN_DETAIL+=("origin/${TO} already contains origin/${FROM}")
        continue
    fi
    if ! git -C "$dir" merge-base --is-ancestor "$to_sha" "$from_sha"; then
        # Linear-history targets (staging/main reject merge commits) can never
        # fast-forward once the source branch carries merges. When the trees
        # already match, a prior exact-tree promote made the branches
        # content-even; otherwise promote by exact-tree commit (single-parent
        # child of TO carrying FROM's tree) — the standing convention.
        if [[ "$(git -C "$dir" rev-parse "${from_sha}^{tree}")" == "$(git -C "$dir" rev-parse "${to_sha}^{tree}")" ]]; then
            PLAN_REPO+=("$label"); PLAN_ACTION+=(skip); PLAN_DETAIL+=("diverged but trees match — content-even")
            continue
        fi
        if ! check_branch_refs "$dir" "$from_sha"; then
            PLAN_REPO+=("$label"); PLAN_ACTION+=(FAIL); PLAN_DETAIL+=("pins a sibling repo to a less-stable branch ref (lines above) — fix the pin before promoting to ${TO}")
            FAILED=1
            continue
        fi
        PLAN_REPO+=("$label"); PLAN_ACTION+=(tree); PLAN_DETAIL+=("exact-tree promote: $(git -C "$dir" log --oneline -1 "$from_sha")")
        continue
    fi
    if ! check_branch_refs "$dir" "$from_sha"; then
        PLAN_REPO+=("$label"); PLAN_ACTION+=(FAIL); PLAN_DETAIL+=("pins a sibling repo to a less-stable branch ref (lines above) — fix the pin before promoting to ${TO}")
        FAILED=1
        continue
    fi
    count="$(git -C "$dir" rev-list --count "${to_sha}..${from_sha}")"
    PLAN_REPO+=("$label"); PLAN_ACTION+=(push); PLAN_DETAIL+=("${count} commit(s): $(git -C "$dir" log --oneline -1 "$from_sha")")
done

plan_pinned_repos

PUSH_COUNT=0
for i in "${!PLAN_REPO[@]}"; do
    printf '  %-22s %-5s %s\n' "${PLAN_REPO[$i]}" "${PLAN_ACTION[$i]}" "${PLAN_DETAIL[$i]}"
    [[ "${PLAN_ACTION[$i]}" == "push" || "${PLAN_ACTION[$i]}" == "tree" ]] && PUSH_COUNT=$((PUSH_COUNT + 1))
done

if [[ "$FAILED" == "1" ]]; then
    echo "Aborting: promotion must be all-or-nothing and at least one repo failed the checks." >&2
    exit 1
fi
if [[ "$PUSH_COUNT" == "0" ]]; then
    echo "Nothing to promote — all repos even."
    exit 0
fi
if [[ "$DRY_RUN" == "1" ]]; then
    echo "Dry run: would push ${PUSH_COUNT} repo(s)."
    exit 0
fi

run_prechecks

if [[ "$ASSUME_YES" != "1" ]]; then
    printf 'Push %s repo(s) %s -> %s? Releases/rebuilds may be triggered. [y/N] ' "$PUSH_COUNT" "$FROM" "$TO"
    read -r answer
    if [[ "$answer" != "y" && "$answer" != "Y" ]]; then
        echo "Aborted."
        exit 1
    fi
fi

repo_slug() {
    git -C "$1" remote get-url origin \
        | sed -E 's#^(git@github\.com:|https://github\.com/)##; s#\.git$##'
}

LAST_PUSHED_SHA=""
push_plan_index() {
    local i="$1" label repo dir from_sha to_sha new_commit
    label="${PLAN_REPO[$i]}"
    repo="${REPOS[$i]}"
    dir="${ROOT_DIR}/${repo}"
    if [[ "${PLAN_ACTION[$i]}" == "tree" ]]; then
        from_sha="$(git -C "$dir" rev-parse "origin/${FROM}")"
        to_sha="$(git -C "$dir" rev-parse "origin/${TO}")"
        new_commit="$(git -C "$dir" commit-tree "${from_sha}^{tree}" -p "$to_sha" -m "Promote ${FROM} tree to ${TO} (exact-tree)")"
        echo "Pushing ${label}: exact-tree ${new_commit} (${FROM} tree) -> ${TO}"
        git -C "$dir" push origin "${new_commit}:refs/heads/${TO}"
        LAST_PUSHED_SHA="$new_commit"
    else
        echo "Pushing ${label}: origin/${FROM} -> ${TO}"
        git -C "$dir" push origin "origin/${FROM}:refs/heads/${TO}"
        LAST_PUSHED_SHA="$(git -C "$dir" rev-parse "origin/${FROM}")"
    fi
    [[ "$repo" == "android" ]] && ANDROID_PROMOTED=1
    # Keep the local TO ref current; best-effort (a checked-out TO in another
    # worktree, or a dirty tree, just leaves the local ref behind).
    if [[ "$(git -C "$dir" symbolic-ref --short --quiet HEAD || true)" == "$TO" ]]; then
        git -C "$dir" merge --ff-only --quiet "origin/${TO}" || true
    else
        git -C "$dir" fetch origin --quiet "${TO}:${TO}" || true
    fi
    return 0
}

# The desktop build downloads the newest CLI release of its channel as the
# bundled first-install seed, and a fresh install runs its whole setup flow
# on that seed before any self-update. Pushing desktop before the cli
# auto-release finishes therefore ships a one-release-stale seed — a real
# compatibility break whenever the new desktop needs the new CLI contract.
# So on auto-release branches the desktop push waits for the cli release,
# and the rebuild is watched to completion with its staged seed verified.
await_cli_release() { # $1 = pushed cli sha; sets AWAITED_CLI_TAG
    local slug sha run_id tag manifest_ok want_prerelease
    slug="$(repo_slug "${ROOT_DIR}/cli")"
    sha="$1"
    AWAITED_CLI_TAG=""
    echo "Waiting for the cli auto-release of ${sha:0:8} on ${TO} ..."
    run_id=""
    for _ in $(seq 1 60); do
        run_id="$(gh run list -R "$slug" --workflow auto-release.yml --branch "$TO" --limit 10 \
            --json databaseId,headSha -q "[.[] | select(.headSha == \"$sha\")][0].databaseId" 2>/dev/null || true)"
        [[ -n "$run_id" && "$run_id" != "null" ]] && break
        sleep 5
    done
    if [[ -z "$run_id" || "$run_id" == "null" ]]; then
        echo "ERROR: no auto-release run appeared for cli@${sha:0:8} on ${TO}." >&2
        return 1
    fi
    echo "  auto-release run ${run_id}: watching ..."
    if ! gh run watch "$run_id" -R "$slug" --exit-status >/dev/null; then
        echo "ERROR: cli auto-release run ${run_id} FAILED — desktop push withheld." >&2
        echo "  Fix or rerun the release, then re-run this promotion (already-even repos skip)." >&2
        return 1
    fi
    # A release only counts once its signed manifest asset is attached.
    want_prerelease="false"
    [[ "$TO" == "staging" ]] && want_prerelease="true"
    for _ in $(seq 1 60); do
        tag="$(gh release list -R "$slug" --limit 10 --json tagName,isPrerelease \
            -q "[.[] | select(.isPrerelease == ${want_prerelease})][0].tagName" 2>/dev/null || true)"
        if [[ -n "$tag" && "$tag" != "null" ]]; then
            manifest_ok="$(gh release view "$tag" -R "$slug" --json assets \
                -q '[.assets[].name] | contains(["update-manifest.json"])' 2>/dev/null || echo false)"
            if [[ "$manifest_ok" == "true" ]]; then
                AWAITED_CLI_TAG="$tag"
                echo "  cli release ${tag} is live with its update manifest."
                return 0
            fi
        fi
        sleep 5
    done
    echo "ERROR: the cli release for run ${run_id} never exposed update-manifest.json." >&2
    return 1
}

watch_desktop_rebuild() { # $1 = pushed desktop sha, $2 = expected cli tag ('' = report only)
    local slug sha run_id staged expected
    slug="$(repo_slug "${ROOT_DIR}/desktop")"
    sha="$1"
    expected="${2#v}"
    echo "Watching the desktop rebuild of ${sha:0:8} on ${TO} ..."
    run_id=""
    for _ in $(seq 1 60); do
        run_id="$(gh run list -R "$slug" --workflow electron-rebuild.yml --branch "$TO" --limit 10 \
            --json databaseId,headSha -q "[.[] | select(.headSha == \"$sha\")][0].databaseId" 2>/dev/null || true)"
        [[ -n "$run_id" && "$run_id" != "null" ]] && break
        sleep 5
    done
    if [[ -z "$run_id" || "$run_id" == "null" ]]; then
        echo "ERROR: no electron-rebuild run appeared for desktop@${sha:0:8} on ${TO}." >&2
        return 1
    fi
    echo "  electron-rebuild run ${run_id}: watching (~20-35 min) ..."
    if ! gh run watch "$run_id" -R "$slug" --exit-status >/dev/null; then
        echo "ERROR: desktop rebuild run ${run_id} FAILED; the ${TO} feed was not (fully) updated." >&2
        echo "  Diagnose: gh run view ${run_id} -R ${slug}" >&2
        return 1
    fi
    staged="$(gh run view "$run_id" -R "$slug" --log 2>/dev/null \
        | grep -m1 -oE 'Staged Openbase Coder CLI [0-9][^ ]*' | awk '{print $5}' || true)"
    if [[ -n "$expected" && -n "$staged" && "$staged" != "$expected" ]]; then
        echo "ERROR: desktop bundled CLI seed ${staged} != released ${expected}." >&2
        echo "  Re-dispatch: gh workflow run electron-rebuild.yml -R ${slug} --ref ${TO}" >&2
        return 1
    fi
    echo "  desktop rebuild succeeded (bundled CLI seed: ${staged:-unknown})."
    return 0
}

DESKTOP_PLANNED=0
for i in "${!PLAN_REPO[@]}"; do
    [[ "${PLAN_ACTION[$i]}" != "push" && "${PLAN_ACTION[$i]}" != "tree" ]] && continue
    [[ "${REPOS[$i]:-}" == "desktop" ]] && DESKTOP_PLANNED=1
done
SEQUENCE_CI=0
if [[ "$WAIT_CI" == "1" && "$DESKTOP_PLANNED" == "1" ]] \
    && [[ "$TO" == "main" || "$TO" == "master" || "$TO" == "staging" ]]; then
    SEQUENCE_CI=1
fi

CLI_PUSHED_SHA=""
DESKTOP_INDEX=""
for i in "${!PLAN_REPO[@]}"; do
    [[ "${PLAN_ACTION[$i]}" != "push" && "${PLAN_ACTION[$i]}" != "tree" ]] && continue
    if [[ "${REPOS[$i]:-}" == "desktop" && "$SEQUENCE_CI" == "1" ]]; then
        DESKTOP_INDEX="$i"
        echo "Deferring desktop: its rebuild must seed the cli release cut by this promotion."
        continue
    fi
    push_plan_index "$i"
    [[ "${REPOS[$i]:-}" == "cli" ]] && CLI_PUSHED_SHA="$LAST_PUSHED_SHA"
done

if [[ -n "$DESKTOP_INDEX" ]]; then
    AWAITED_CLI_TAG=""
    if [[ -n "$CLI_PUSHED_SHA" ]]; then
        await_cli_release "$CLI_PUSHED_SHA"
    fi
    push_plan_index "$DESKTOP_INDEX"
    watch_desktop_rebuild "$LAST_PUSHED_SHA" "${AWAITED_CLI_TAG:-}"
fi

echo "Promoted ${PUSH_COUNT} repo(s) ${FROM} -> ${TO}."

# Auto-publish the Android APK + marketing downloads-card bump after a
# production promotion, once the android repo has actually been promoted to
# main. This runs LAST and on purpose does not unwind the promotions already
# pushed above: a build/upload/marketing failure surfaces as a loud error
# summary and a non-zero exit here, but every repo push already succeeded.
if [[ "$TO" == "main" || "$TO" == "master" ]] && [[ "$ANDROID_PROMOTED" == "1" ]]; then
    echo
    echo "Publishing Android APK (android was promoted to ${TO}) ..."
    if ! "$SCRIPT_DIR/publish-android-apk"; then
        echo >&2
        echo "ERROR: Android APK publish FAILED after the promotion completed." >&2
        echo "  All ${PUSH_COUNT} repo(s) were promoted ${FROM} -> ${TO} successfully," >&2
        echo "  but building/uploading the APK or bumping the marketing card did not." >&2
        echo "  Fix the cause and re-run standalone: scripts/publish-android-apk" >&2
        exit 1
    fi
fi
