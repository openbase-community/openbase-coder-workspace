#!/usr/bin/env bash

# Promote branches across the workspace repos, in dependency order, as a
# fast-forward-only burst.
#
# Providers are pushed before consumers so anything that rebuilds on a branch
# push always sees its dependencies already advanced, and pushes land close
# together. Repos whose branches are already even are skipped entirely so
# they trigger no rebuild/release.
#
# Order rationale: super-agents is the Python lib cli and agent-work-scheduler
# build against; coder-react is the JS lib console/desktop consume; the cli
# standalone release embeds console/coder-react/skills/super-agents at build
# time, so all of those land before cli. Pushing main auto-cuts the cli
# standalone release (auto-release.yml), the desktop AppImage to S3
# (electron-rebuild.yml), and the ios App Store upload. A cli push whose
# head commit says [skip release] cuts no release and never cancels an
# in-flight release build (conditional cancel-in-progress; AUTO_UPDATE.md).
# multi-react and boilersync-react are external symlinks — promote them in
# their own workspaces (~/Projects/multi, ~/Projects/boilersync) first if
# they changed.
#
# When a promotion into main/master actually moves the android repo, this
# script runs scripts/publish-android-apk as its final step (build + upload
# the APK to S3, bump the marketing downloads-card label). That runs after
# every push, so a failure there never unwinds the promotions — it just prints
# a loud error summary and exits non-zero at the end.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

# Dependency order: providers before consumers; workspace root last.
REPOS=(super-agents skills coder-react console cli agent-work-scheduler desktop allauth-client-swift ios allauth-client-kotlin android .)

EXTERNAL_NOTE="multi-react and boilersync-react are external trunk-based projects pinned to main (multi.json fixedBranch; CI checks them out at main)"

# Pre-release checks run before a production promotion (TO is main/master),
# unless --skip-checks. Format: "label|repo dir|command|severity" where
# severity is `fatal` (failure aborts the whole promotion) or `warn` (failure
# only prints a warning). These mirror the deploy skill's Section 0
# preconditions; edit this list to change what a production promotion gates on.
PRECHECKS=(
    "cli test suite|cli|uv run pytest -q|fatal"
    "console typecheck|console|pnpm exec tsc --noEmit -p tsconfig.app.json|fatal"
    "desktop typecheck|desktop|pnpm exec tsc --noEmit -p tsconfig.app.json|fatal"
    "desktop mac-release prereqs|desktop|pnpm run release:preflight:mac|warn"
)

usage() {
    cat <<EOF
Usage: $(basename "$0") FROM TO [options]

Fast-forward FROM into TO across every workspace repo, provider-first
(${REPOS[*]}). FROM and TO are any branch names — feature branches work too;
repos that do not have FROM are skipped, as are repos already even (no
rebuild/release triggered). Aborts before pushing anything if any repo cannot
fast-forward, or if promoted content pins a sibling repo to a less-stable
branch ref (e.g. git+...@staging landing on main — main must point to main).

Examples:
  $(basename "$0") staging main
  $(basename "$0") develop staging
  $(basename "$0") feature/my-feature staging

Before promoting into main/master, the deploy skill's pre-release checks run
automatically (cli test suite, console/desktop typecheck; desktop mac-release
prereqs as a non-blocking warning). A failing fatal check aborts before any
push. Other targets skip the checks.

Options:
  --dry-run          Show the plan and exit without pushing (no checks run).
  --skip-checks      Skip the pre-release checks (still gated on fast-forward).
  --exclude REPO     Hold REPO back (repeatable; comma-separated allowed).
                     Use for consumers that must wait on an earlier repo's
                     release, e.g. --exclude desktop while the cli release
                     publishes, then re-run to promote desktop alone.
  -y, --yes          Push without the confirmation prompt.
  -h, --help         Show this help text.
EOF
}

DRY_RUN=0
ASSUME_YES=0
SKIP_CHECKS=0
declare -a EXCLUDE=()
FROM=""
TO=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1 ;;
        --skip-checks) SKIP_CHECKS=1 ;;
        --exclude)
            shift
            [[ $# -gt 0 ]] || { echo "--exclude needs a repo name" >&2; usage >&2; exit 2; }
            IFS=',' read -ra _ex <<<"$1"
            EXCLUDE+=("${_ex[@]}")
            ;;
        -y|--yes) ASSUME_YES=1 ;;
        -h|--help) usage; exit 0 ;;
        -*) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
        *)
            if [[ -z "$FROM" ]]; then FROM="$1"
            elif [[ -z "$TO" ]]; then TO="$1"
            else echo "Unexpected argument: $1" >&2; usage >&2; exit 2
            fi
            ;;
    esac
    shift
done

if [[ -z "$FROM" || -z "$TO" ]]; then
    usage >&2
    exit 2
fi
if [[ "$FROM" == "$TO" ]]; then
    echo "FROM and TO must differ." >&2
    exit 2
fi

repo_label() {
    if [[ "$1" == "." ]]; then echo "workspace-root"; else echo "$1"; fi
}

is_excluded() {
    local r="$1" e
    ((${#EXCLUDE[@]})) || return 1
    for e in "${EXCLUDE[@]}"; do
        [[ "$e" == "$r" ]] && return 0
    done
    return 1
}

# "Main points to main": content promoted into a stabler branch must not pin
# sibling repos to a less-stable branch ref. Branch-agnostic dep forms
# (file:../, workspace:*, PyPI pins) pass by construction; only branch-pinned
# git URLs are flagged. Prints offending lines; returns 0 when clean.
check_branch_refs() {
    local dir="$1" rev="$2" guarded=""
    case "$TO" in
        main|master) guarded='staging|develop' ;;
        staging) guarded='develop' ;;
        *) return 0 ;;
    esac
    local pattern="(git\\+http|github:|git@github)[^\"'[:space:]]*[@#](${guarded})([^A-Za-z0-9_-]|\$)"
    ! git -C "$dir" grep -nIE "$pattern" "$rev" -- 2>/dev/null
}

# Run the deploy skill's pre-release checks before a production promotion.
# Only gates when promoting into main/master; other targets (develop->staging,
# feature->staging) skip the heavy suite. --skip-checks bypasses entirely. A
# fatal check that fails aborts before anything is pushed.
run_prechecks() {
    case "$TO" in
        main|master) : ;;
        *) return 0 ;;
    esac
    if [[ "$SKIP_CHECKS" == "1" ]]; then
        echo "Skipping pre-release checks (--skip-checks)."
        return 0
    fi
    echo "Running pre-release checks before promoting to ${TO} ..."
    local failed=0 entry label reldir cmd sev dir out
    for entry in "${PRECHECKS[@]}"; do
        IFS='|' read -r label reldir cmd sev <<<"$entry"
        dir="${ROOT_DIR}/${reldir}"
        if [[ ! -d "$dir" ]]; then
            printf '  %-30s SKIP (no %s)\n' "$label" "$reldir"
            continue
        fi
        if [[ "$cmd" == *tsc* && ! -d "$dir/node_modules" ]]; then
            printf '  %-30s SKIP (node_modules not installed)\n' "$label"
            continue
        fi
        printf '  %-30s ... ' "$label"
        out="$(mktemp)"
        if ( cd "$dir" && eval "$cmd" ) >"$out" 2>&1; then
            echo "ok"
        elif [[ "$sev" == "warn" ]]; then
            echo "WARN (non-blocking)"
            sed 's/^/      /' "$out" | tail -n 12
        else
            echo "FAIL"
            sed 's/^/      /' "$out" | tail -n 30
            failed=1
        fi
        rm -f "$out"
    done
    if [[ "$failed" == "1" ]]; then
        echo "Aborting: pre-release checks failed. Fix them, or re-run with --skip-checks to override." >&2
        exit 1
    fi
}

declare -a PLAN_REPO PLAN_ACTION PLAN_DETAIL
FAILED=0
ANDROID_PROMOTED=0

echo "Planning promotion ${FROM} -> ${TO} ..."
if [[ -n "${EXTERNAL_NOTE:-}" ]]; then
    echo "note: ${EXTERNAL_NOTE}"
fi
for repo in "${REPOS[@]}"; do
    dir="${ROOT_DIR}/${repo}"
    label="$(repo_label "$repo")"
    if is_excluded "$repo"; then
        PLAN_REPO+=("$label"); PLAN_ACTION+=(skip); PLAN_DETAIL+=("excluded (--exclude)")
        continue
    fi
    git -C "$dir" fetch origin --quiet
    if ! from_sha="$(git -C "$dir" rev-parse --verify --quiet "origin/${FROM}")"; then
        PLAN_REPO+=("$label"); PLAN_ACTION+=(skip); PLAN_DETAIL+=("no origin/${FROM} branch")
        continue
    fi
    if ! to_sha="$(git -C "$dir" rev-parse --verify --quiet "origin/${TO}")"; then
        PLAN_REPO+=("$label"); PLAN_ACTION+=(FAIL); PLAN_DETAIL+=("no origin/${TO} branch (refusing to create it)")
        FAILED=1
        continue
    fi
    if [[ "$from_sha" == "$to_sha" ]]; then
        PLAN_REPO+=("$label"); PLAN_ACTION+=(skip); PLAN_DETAIL+=("even — no rebuild")
        continue
    fi
    if git -C "$dir" merge-base --is-ancestor "$from_sha" "$to_sha"; then
        PLAN_REPO+=("$label"); PLAN_ACTION+=(skip); PLAN_DETAIL+=("origin/${TO} already contains origin/${FROM}")
        continue
    fi
    if ! git -C "$dir" merge-base --is-ancestor "$to_sha" "$from_sha"; then
        PLAN_REPO+=("$label"); PLAN_ACTION+=(FAIL); PLAN_DETAIL+=("diverged — cannot fast-forward")
        FAILED=1
        continue
    fi
    if ! check_branch_refs "$dir" "$from_sha"; then
        PLAN_REPO+=("$label"); PLAN_ACTION+=(FAIL); PLAN_DETAIL+=("pins a sibling repo to a less-stable branch ref (lines above) — fix the pin before promoting to ${TO}")
        FAILED=1
        continue
    fi
    count="$(git -C "$dir" rev-list --count "${to_sha}..${from_sha}")"
    PLAN_REPO+=("$label"); PLAN_ACTION+=(push); PLAN_DETAIL+=("${count} commit(s): $(git -C "$dir" log --oneline -1 "$from_sha")")
done

PUSH_COUNT=0
for i in "${!PLAN_REPO[@]}"; do
    printf '  %-22s %-5s %s\n' "${PLAN_REPO[$i]}" "${PLAN_ACTION[$i]}" "${PLAN_DETAIL[$i]}"
    [[ "${PLAN_ACTION[$i]}" == "push" ]] && PUSH_COUNT=$((PUSH_COUNT + 1))
done

if [[ "$FAILED" == "1" ]]; then
    echo "Aborting: promotion must be all-or-nothing and at least one repo failed the checks." >&2
    exit 1
fi
if [[ "$PUSH_COUNT" == "0" ]]; then
    echo "Nothing to promote — all repos even."
    exit 0
fi
if [[ "$DRY_RUN" == "1" ]]; then
    echo "Dry run: would push ${PUSH_COUNT} repo(s)."
    exit 0
fi

run_prechecks

if [[ "$ASSUME_YES" != "1" ]]; then
    printf 'Push %s repo(s) %s -> %s? Releases/rebuilds may be triggered. [y/N] ' "$PUSH_COUNT" "$FROM" "$TO"
    read -r answer
    if [[ "$answer" != "y" && "$answer" != "Y" ]]; then
        echo "Aborted."
        exit 1
    fi
fi

for i in "${!PLAN_REPO[@]}"; do
    [[ "${PLAN_ACTION[$i]}" != "push" ]] && continue
    label="${PLAN_REPO[$i]}"
    repo="${REPOS[$i]}"
    dir="${ROOT_DIR}/${repo}"
    echo "Pushing ${label}: origin/${FROM} -> ${TO}"
    git -C "$dir" push origin "origin/${FROM}:refs/heads/${TO}"
    [[ "$repo" == "android" ]] && ANDROID_PROMOTED=1
    # Keep the local TO ref current; best-effort (a checked-out TO in another
    # worktree, or a dirty tree, just leaves the local ref behind).
    if [[ "$(git -C "$dir" symbolic-ref --short --quiet HEAD || true)" == "$TO" ]]; then
        git -C "$dir" merge --ff-only --quiet "origin/${TO}" || true
    else
        git -C "$dir" fetch origin --quiet "${TO}:${TO}" || true
    fi
done

echo "Promoted ${PUSH_COUNT} repo(s) ${FROM} -> ${TO}."

# Auto-publish the Android APK + marketing downloads-card bump after a
# production promotion, once the android repo has actually been promoted to
# main. This runs LAST and on purpose does not unwind the promotions already
# pushed above: a build/upload/marketing failure surfaces as a loud error
# summary and a non-zero exit here, but every repo push already succeeded.
if [[ "$TO" == "main" || "$TO" == "master" ]] && [[ "$ANDROID_PROMOTED" == "1" ]]; then
    echo
    echo "Publishing Android APK (android was promoted to ${TO}) ..."
    if ! "$SCRIPT_DIR/publish-android-apk"; then
        echo >&2
        echo "ERROR: Android APK publish FAILED after the promotion completed." >&2
        echo "  All ${PUSH_COUNT} repo(s) were promoted ${FROM} -> ${TO} successfully," >&2
        echo "  but building/uploading the APK or bumping the marketing card did not." >&2
        echo "  Fix the cause and re-run standalone: scripts/publish-android-apk" >&2
        exit 1
    fi
fi
