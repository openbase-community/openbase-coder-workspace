#!/usr/bin/env bash
set -euo pipefail

workspace_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
repos=(
  .
  ios
  desktop
  cli
  coder-react
  console
  android
  skills
  super-agents
  boilersync-react
)

violations=()
legacy_product_name="Openbase"" Coder"

for repo in "${repos[@]}"; do
  repo_dir="$workspace_root"
  [[ "$repo" == "." ]] || repo_dir="$workspace_root/$repo"
  [[ -d "$repo_dir" ]] || continue

  while IFS= read -r match; do
    [[ -z "$match" ]] && continue
    match="${match#./}"
    case "$repo:$match" in
      "cli:openbase_coder_cli/cli/desktop.py:"*"$legacy_product_name"*) ;;
      "cli:openbase_coder_cli/cli/computer_use.py:"*"$legacy_product_name.app/"*) ;;
      "cli:tests/test_desktop_cli.py:"*"$legacy_product_name"*) ;;
      "desktop:electron/installer-cleanup.cjs:"*"$legacy_product_name.app"*) ;;
      "desktop:electron/installer-cleanup.node-test.cjs:"*"$legacy_product_name.app"*) ;;
      *) violations+=("$repo:$match") ;;
    esac
  done < <(
    cd "$repo_dir"
    rg --hidden --no-heading --color never -n -i \
      -g '!.git/**' -g '!node_modules/**' -g '!dist/**' -g '!release/**' \
      'openbase[[:space:]]+coder' . 2>/dev/null || true
  )
done

if (( ${#violations[@]} > 0 )); then
  printf 'Unauthorized legacy brand references found:\n' >&2
  printf '  %s\n' "${violations[@]}" >&2
  exit 1
fi

echo "Brand check passed: human-facing product name is Openbase."
